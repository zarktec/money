# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Wompi (https://docs.wompi.co) — usar llaves de sandbox en desarrollo
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_xxx
WOMPI_PRIVATE_KEY=prv_test_xxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxx
WOMPI_EVENTS_SECRET=test_events_xxx
WOMPI_API_URL=https://sandbox.wompi.co/v1

# Cron de Vercel (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Cifrado de tokens de correo (32 bytes en base64: openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=

# IA (lectura de texto, recibos, extractos PDF y, más adelante, correos)
ANTHROPIC_API_KEY=
# Modelo de extracción. Por defecto claude-opus-5-5 (el recomendado por Anthropic). Para abaratar el costo por usuario
# se puede usar uno más pequeño, p. ej. claude-haiku-5-5: pruébalo con tus propios recibos antes de cambiarlo.
ANTHROPIC_MODEL=

# Notificaciones push (genera el par con: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@correo.com

# Correo (fase 6). Google: consola de Google Cloud → OAuth (alcance gmail.readonly); Microsoft: Entra ID → registro de aplicación.
# URIs de redirección: {NEXT_PUBLIC_APP_URL}/api/email/google/callback y /api/email/microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Firma el parámetro state del flujo OAuth (openssl rand -base64 32). Distinta de TOKEN_ENCRYPTION_KEY.
OAUTH_STATE_SECRET=

# Datos del responsable para las páginas legales (/privacidad y /terminos). Lo que falte se muestra resaltado en el texto.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_NIT=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_EMAIL=
# Poner en true SOLO cuando un abogado haya revisado y aprobado los textos: quita el aviso de borrador.
NEXT_PUBLIC_LEGAL_REVIEWED=false

# Correos de la app por Resend (recordatorios, vencimiento del plan, recibos). Los de la cuenta (confirmar, recuperar clave) van por el SMTP de Supabase.
# Dominio verificado en resend.com y API key con permiso de envío. MAIL_FROM debe ser de ese dominio, p. ej.  Money <avisos@mail.tudominio.com>
RESEND_API_KEY=
MAIL_FROM=
# Opcional: a dónde llegan las respuestas de los usuarios.
MAIL_REPLY_TO=
